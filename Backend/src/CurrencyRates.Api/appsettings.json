{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatProvider": "System.Globalization.CultureInfo::InvariantCulture, System.Private.CoreLib",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/currency-rates-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "restrictedToMinimumLevel": "Information",
          "formatProvider": "System.Globalization.CultureInfo::InvariantCulture, System.Private.CoreLib",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimit": 60,
    "Window": "00:01:00"
  },
  "Display": {
    "DateFormat": "yyyy-MM-dd",
    "CurrencySortOrder": "CodeAscending"
  },
  "CurrencyProviders": {
    "Nbp": {
      "DisplayName": "Narodowy Bank Polski",
      "BaseUrl": "https://api.nbp.pl/api/",
      "MaxDaysPerRequest": 367,
      "CurrencyListCacheDuration": "01:00:00",
      "Resilience": {
        "MaxRetryAttempts": 3,
        "RetryBaseDelay": "00:00:00.500",
        "AttemptTimeout": "00:00:10",
        "TotalRequestTimeout": "00:00:30"
      }
    }
  }
}
